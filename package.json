{
  "name": "ddmed-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo entrypoint for DDMed",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:build:test": "npm --prefix frontend run build:test",
    "frontend:test": "npm --prefix frontend test",
    "frontend:clean": "npm --prefix frontend run clean",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "dev:up": "docker compose -f infra/compose.yaml -f infra/compose.dev.yaml up --build",
    "dev:down": "docker compose -f infra/compose.yaml -f infra/compose.dev.yaml down",
    "dev:logs": "docker compose -f infra/compose.yaml -f infra/compose.dev.yaml logs -f",
    "snowstorm:init:ips": "node scripts/init-snowstorm-ips.mjs",
    "snowstorm:name:ips": "node scripts/init-snowstorm-ips.mjs --update-name-only"
  }
}
