{
  "name": "ddmed-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo entrypoint for DDMed",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:build:test": "npm --prefix frontend run build:test",
    "frontend:test": "npm --prefix frontend test",
    "frontend:clean": "npm --prefix frontend run clean",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "dev:up": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-up.ps1",
    "dev:down": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1",
    "dev:logs": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-logs.ps1"
  }
}
